# FlyAway Database Configuration
# If DB_HOST is set, ds connects to MySQL/MariaDB.
# If DB_HOST is omitted, ds falls back to local SQLite (flyaway.db).

DB_HOST=192.168.2.10
DB_PORT=3306
DB_DATABASE=flyaway
DB_USER=flyaway
DB_PASSWORD=flyawaypass

# Optional server overrides
# FLYAWAY_DS_URL=https://localhost:8000/
# FLYAWAY_SERVER_URL=https://localhost:8000/
# FLYAWAY_TOKEN=e1111111-1111-1111-1111-111111111111
